# Poetry AI v1 — variables de entorno.
# Copia a .env.local para desarrollo. En producción, configúralas en tu host.
# Todo lo que empieza con NEXT_PUBLIC_ llega al navegador; el resto es solo servidor.

# ---- Supabase (Auth + Postgres + Storage) ----
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role: SOLO servidor (nunca NEXT_PUBLIC_). La usan los RPCs de rosas,
# las páginas públicas /s/[id] y las imágenes OG.
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenRouter (toda la IA: texto, imagen, voz, música) ----
# https://openrouter.ai/keys — sin esta key, la generación devuelve un error
# claro; el resto de la app funciona.
OPENROUTER_API_KEY=
# Modelos (opcionales — estos son los defaults):
OPENROUTER_TEXT_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_CODE_MODEL=anthropic/claude-sonnet-4
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_TTS_MODEL=openai/gpt-audio-mini
OPENROUTER_TTS_VOICE=coral
OPENROUTER_MUSIC_MODEL=google/lyria-3-clip-preview

# ---- Supermemory (memoria de conversaciones y de personas) ----
# Opcional: sin key, la app funciona sin memoria (degradación elegante).
# https://supermemory.ai
SUPERMEMORY_API_KEY=

# ---- Polar (suscripciones y recargas de rosas) ----
# Apagado por defecto. Pon POLAR_ENABLED=true solo cuando la cuenta esté lista.
POLAR_ENABLED=false
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Rosas otorgadas por ciclo de suscripción y por compra única:
POLAR_MONTHLY_ROSES=100
POLAR_TOPUP_ROSES=50

# ---- App ----
# URL pública (links de compartir y Open Graph). Sin trailing slash.
NEXT_PUBLIC_APP_URL=https://poetry-ai.app
